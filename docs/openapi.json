{
  "components": {
    "schemas": {
      "DirectoryListingResponse": {
        "description": "Response body for server-side directory browsing.",
        "properties": {
          "directories": {
            "items": {
              "type": "string"
            },
            "title": "Directories",
            "type": "array"
          },
          "parent_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Path"
          },
          "path": {
            "title": "Path",
            "type": "string"
          }
        },
        "required": [
          "path",
          "parent_path",
          "directories"
        ],
        "title": "DirectoryListingResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "PurgeRequest": {
        "description": "Request body for orphan metadata cleanup.",
        "properties": {
          "retention_days": {
            "default": 3,
            "minimum": 0.0,
            "title": "Retention Days",
            "type": "integer"
          }
        },
        "title": "PurgeRequest",
        "type": "object"
      },
      "RootCreate": {
        "description": "Request body for creating an indexed root.",
        "properties": {
          "path": {
            "format": "path",
            "title": "Path",
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "title": "RootCreate",
        "type": "object"
      },
      "ScanRequest": {
        "description": "Request body for starting an indexing scan.",
        "properties": {
          "root_path": {
            "anyOf": [
              {
                "format": "path",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Root Path"
          }
        },
        "title": "ScanRequest",
        "type": "object"
      },
      "TagCreate": {
        "description": "Request body for creating or applying a tag.",
        "properties": {
          "name": {
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "TagCreate",
        "type": "object"
      },
      "TagUpdate": {
        "description": "Request body for renaming a tag.",
        "properties": {
          "name": {
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "TagUpdate",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
